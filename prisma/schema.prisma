generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CONTRIBUTOR
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum MediaCategory {
  CLEANUP
  COMMUNITY_DAY
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(CONTRIBUTOR)
  emailVerified      Boolean             @default(false)
  avatarUrl          String?
  profileVisibility  ProfileVisibility   @default(PUBLIC)
  verifyToken        String?
  verifyTokenExpires DateTime?
  createdAt          DateTime            @default(now())
  posts              Post[]
  comments           Comment[]
}

model Event {
  id            String        @id @default(cuid())
  title         String
  description   String
  date          DateTime
  location      String
  capacityLimit Int           @default(0)
  createdAt     DateTime      @default(now())
  registrations Registration[]
}

model Registration {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String
  age              Int
  emergencyContact String?
  notes            String?
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
}

model Volunteer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  age       Int
  createdAt DateTime @default(now())
}

model Post {
  id        String     @id @default(cuid())
  title     String
  body      String
  imageUrl  String?
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status    PostStatus @default(PENDING)
  createdAt DateTime   @default(now())
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Media {
  id        String         @id @default(cuid())
  caption   String
  url       String
  type      MediaType      @default(PHOTO)
  category  MediaCategory?
  createdAt DateTime       @default(now())
}

model SiteStat {
  key   String @id
  value String
}

model TeamMember {
  id        String @id @default(cuid())
  name      String
  role      String
  bio       String
  sortOrder Int    @default(0)
}
